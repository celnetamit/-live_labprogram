generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  organization  String?
  designation   String?
  role          String    @default("USER")
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// When this admin last opened the notification tray. Anything that happened
  /// after it is unread. Defaulting to now() means the column backfills to the
  /// migration time, so existing admins do not open the tray to a wall of every
  /// signup the platform has ever had.
  notificationsSeenAt DateTime @default(now())

  accounts      Account[]
  sessions      Session[]
  authenticators Authenticator[]
  passwordResets PasswordResetToken[]
  notificationPreference NotificationPreference?
  labAccess     LabAccess[]
  ownedLabs     Lab[]     @relation("LabOwner")
  accessRequests AccessRequest[]
  orders        Order[]
  customLabRequests CustomLabRequest[]
  labFeedback       LabFeedback[]
  labReviews        LabReview[]
  reviewerAgreements ReviewerAgreement[]
  /// Marks an account as an expert reviewer.
  ///
  /// Reviewers get the NanoSchool Expert Review Form inside any lab they can
  /// open. It is a platform-level flag rather than a per-lab assignment
  /// because a reviewer's standing is a property of the person — their domain
  /// expertise — and which labs they may review is already decided by the
  /// access they hold. Adding a second per-lab table would let the two
  /// disagree.
  isReviewer        Boolean  @default(false)
  labProjects   LabProject[]
  labProgress   LabProgress[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Platform-wide configuration, edited from /admin/settings.
///
/// One row, fixed id, created on first read. Every field here is enforced
/// somewhere — a switch that saved but changed nothing would be worse than no
/// switch at all.
model PlatformSetting {
  id                      String   @id @default("singleton")

  // --- General ---
  platformName            String   @default("Panoptical Labs Ecosystem")
  supportEmail            String   @default("support@panoptical.ai")
  /// Off closes /register and the registration API to new sign-ups.
  allowPublicRegistration Boolean  @default(true)
  /// On disables self-serve checkout: labs are obtained by request only.
  requireAdminApproval    Boolean  @default(false)
  /// On shuts learners out; SUPER_ADMINs keep working.
  maintenanceMode         Boolean  @default(false)
  maintenanceMessage      String?

  // --- Security & Auth ---
  minPasswordLength       Int      @default(8)
  /// How long a signed-in session stays valid, in days.
  sessionDays             Int      @default(30)
  /// Google sign-in — the "Continue with Google" button on /login and /register.
  allowSso                Boolean  @default(true)
  /// Unused since biometric sign-in was removed; kept so the column is not
  /// dropped by `prisma db push` on an existing database.
  allowBiometrics         Boolean  @default(true)

  // --- Email ---
  mailFromName            String   @default("Panoptical Labs")
  mailReplyTo             String?

  updatedAt               DateTime @updatedAt
  updatedBy               String?
}

/// A key for machine access to the read-only admin API.
///
/// Only a hash is stored, so a leaked database cannot be used to call the API;
/// the full key is shown once at creation and never again.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  /// Human-recognisable opening characters, e.g. "pk_live_8f3a".
  prefix     String
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  createdBy  String?

  @@index([revokedAt])
}

/// An outbound HTTP endpoint notified when platform events occur.
///
/// The secret is stored in readable form because it is needed to compute the
/// HMAC signature on every delivery — the same trade-off Stripe and GitHub make.
model Webhook {
  id            String    @id @default(cuid())
  url           String
  secret        String
  /// JSON array of event names, e.g. ["order.paid","access.approved"].
  events        String    @default("[]")
  enabled       Boolean   @default(true)
  lastStatus    Int?
  lastAttemptAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())

  @@index([enabled])
}

/// Which emails a learner wants. Absent row means "everything on" — the
/// defaults below are also what a new account gets.
model NotificationPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  /// Lab access request approved or declined.
  accessDecisions   Boolean  @default(true)
  /// Payment receipts and order confirmations.
  orderReceipts     Boolean  @default(true)
  /// Replies on a custom lab request.
  labRequestUpdates Boolean  @default(true)
  /// An upcoming lab opening for enrolment.
  labLaunches       Boolean  @default(true)
  /// Occasional product news. Off by default — opt in, not out.
  productNews       Boolean  @default(false)
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A pending "forgot my password" request.
///
/// Only a SHA-256 hash of the token is stored: the raw value exists solely in
/// the emailed link, so a leaked database cannot be used to reset anyone's
/// password. Tokens are single-use and short-lived.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A registered WebAuthn credential — a passkey, unlocked on the user's device
/// by Touch ID, Windows Hello, an Android fingerprint or a security key.
///
/// Only the *public* key is stored. The private key never leaves the device and
/// the biometric itself is never transmitted: the device verifies the finger or
/// face locally, then signs our challenge. A stolen database therefore yields
/// nothing that can be used to sign in.
model Authenticator {
  id           String   @id @default(cuid())
  userId       String
  /// Base64URL credential ID returned by the authenticator.
  credentialId String   @unique
  /// COSE public key bytes used to verify assertion signatures.
  publicKey    Bytes
  /// Signature counter; a value that fails to advance suggests a cloned key.
  counter      Int      @default(0)
  /// JSON array, e.g. ["internal","hybrid"].
  transports   String?
  /// "singleDevice" | "multiDevice" (a synced passkey).
  deviceType   String?
  backedUp     Boolean  @default(false)
  /// What the user calls it, e.g. "MacBook Touch ID".
  label        String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A one-time WebAuthn challenge. Kept server-side and deleted on use so a
/// captured assertion cannot be replayed.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  /// Set for registration flows (who is enrolling a device).
  userId    String?
  /// Set for login flows when the user typed an email first.
  email     String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Lab {
  id          String   @id @default(cuid())
  slug        String?  @unique
  name        String
  description String?
  synopsis    String?
  subject     String?
  difficulty  String?  // Beginner, Intermediate, Advanced
  points      Int      @default(0)
  instructions String?
  starterCode String?
  sourceUrl   String?  // live lab launch URL
  tags        String?  // JSON string array
  keySkills   String?  // JSON string array
  priceMinor  Int      @default(49900)
  currency    String   @default("INR")
  enabled     Boolean  @default(true)
  domainUrl   String   @unique
  category    String?
  thumbnail   String?
  accessType  String   @default("PRIVATE") // PUBLIC, PRIVATE, SUBSCRIPTION
  status      String   @default("ACTIVE") // ACTIVE, UPCOMING, MAINTENANCE, ARCHIVED
  launchAt    DateTime? // expected availability date, shown on UPCOMING labs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId     String?
  owner       User?    @relation("LabOwner", fields: [ownerId], references: [id])

  accesses    LabAccess[]
  accessRequests AccessRequest[]
  feedback    LabFeedback[]
  reviews     LabReview[]
  reviewerAgreements ReviewerAgreement[]
  orderItems  OrderItem[]
  plannedFrom CustomLabRequest[] @relation("PlannedLab")
  blogPosts   BlogPost[]
}

/// An article on the public blog at /blog.
///
/// Posts live in the database, unlike the lab guides in `src/content`, because
/// publishing an article should not wait on a code review and a deploy — on this
/// hub a push to main *is* a deploy.
///
/// `focusKeyword` is the one search phrase the post is written to rank for. The
/// admin editor warns when two posts share one, because pages competing for the
/// same query split its ranking between them. `keywords` follows the JSON
/// string-array convention of `Lab.tags`.
///
/// `body` is a deliberately small Markdown subset (`src/lib/blog.ts`), rendered
/// to React elements rather than to an HTML string, so there is nothing to
/// sanitise.
model BlogPost {
  id           String    @id @default(cuid())
  /// The URL: /blog/<slug>. Changing it on a published post breaks every link to it.
  slug         String    @unique
  title        String
  /// Optional shorter title for search results; falls back to `title`.
  metaTitle    String?
  /// The meta description, and the summary on post cards and in the RSS feed.
  description  String    @default("")
  body         String    @default("")
  focusKeyword String    @default("")
  keywords     String    @default("[]")
  /// A site path (/showcase/x.jpg) or an absolute URL. Without one, a share card
  /// is generated at /blog/og/<slug>.
  coverImage   String?
  coverAlt     String?
  authorName   String    @default("")
  status       String    @default("DRAFT") // DRAFT | PUBLISHED
  /// Set the first time the post is published and kept after that, so taking a
  /// post down to fix something does not re-date the article.
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?

  labId        String?
  lab          Lab?      @relation(fields: [labId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([labId, status])
}

model LabAccess {
  id        String   @id @default(cuid())
  userId    String
  labId     String
  grantedAt DateTime @default(now())
  expiresAt DateTime?
  grantedBy String?  // Admin ID who granted
  source    String   @default("ADMIN") // ADMIN | PURCHASE
  /// Which tier of the lab this grant covers.
  ///
  /// A row in this table means "may open this lab at all", which is what every
  /// purchaser has. Some labs also sell a premium tier on top — MicrobeAI's
  /// Advanced Mode is one — and conflating the two hands the premium tier to
  /// everyone who bought the lab. STANDARD is the default precisely so that
  /// existing grants do not silently become premium ones.
  ///
  /// STANDARD | ADVANCED
  tier      String   @default("STANDARD")
  orderId   String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab       Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([userId, labId])
  @@map("user_lab_access")
}

model Order {
  id               String   @id @default(cuid())
  userId           String
  status           String   @default("PENDING") // PENDING | PAID | FAILED
  amountMinor      Int
  currency         String   @default("INR")
  provider         String   @default("mock") // razorpay | mock
  providerOrderId  String?
  providerPaymentId String?
  createdAt        DateTime @default(now())
  paidAt           DateTime?

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            OrderItem[]
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  labId      String
  labSlug    String
  labTitle   String
  priceMinor Int

  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lab        Lab    @relation(fields: [labId], references: [id], onDelete: Cascade)
}

model AccessRequest {
  id          String   @id @default(cuid())
  userId      String
  labId       String
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedAt DateTime @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  notes       String?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab         Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
}

/// A learner's pitch for a lab we don't offer yet. Admins triage these on
/// /admin/lab-requests and can turn an accepted one into an UPCOMING lab.
model CustomLabRequest {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String
  subject      String?
  difficulty   String?
  audience     String?  // who the lab is for (team, cohort, self)
  timeline     String?  // when they'd need it
  status       String   @default("PENDING") // PENDING, UNDER_REVIEW, PLANNED, DECLINED
  adminNotes   String?  // visible to the requester as the admin's reply
  reviewedAt   DateTime?
  reviewedBy   String?
  plannedLabId String?  // set when the request became an upcoming lab
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedLab Lab? @relation("PlannedLab", fields: [plannedLabId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
}

/**
 * Feedback a learner sends from inside a lab.
 *
 * The identity fields need explaining, because there are two of them and that
 * looks redundant. `userId` is who was signed in — established by the lab
 * session token, not by anything typed. `name`, `email` and `designation` are
 * what the person filling in the form said about themselves, and they are kept
 * separately because they are not always the same claim: labs run on shared
 * machines and in teaching sessions, so the person at the keyboard is not
 * reliably the account holder, and the reply address they want may not be the
 * one they signed up with. Overwriting either with the other would destroy the
 * only signal that they differed.
 *
 * `designation` is the job title or role the sender is writing in. The account
 * carries one too, set at registration, and this is not it: registration
 * details go stale, and someone may be writing in a different capacity from the
 * one they signed up in. Both are available to whoever reads the feedback, and
 * the difference between them is occasionally the interesting part. It is the
 * field that makes a report actionable — "this is confusing" from a plant
 * operator and from a postgraduate are different findings.
 */
model LabFeedback {
  id          String   @id @default(cuid())
  /** The account that was signed in when this was sent. */
  userId      String
  labId       String?
  /**
   * Denormalised for reading, and nullable because Lab.slug is. `labId` is the
   * real key; this is here so a feedback list is legible without a join, and
   * so a row survives its lab being deleted with something human-readable on it.
   */
  labSlug     String?
  /** What the sender typed about themselves — never overwritten from the account. */
  name        String
  email       String
  designation String
  /** 1–5, optional: a rating without a comment is close to noise. */
  rating      Int?
  category    String   @default("GENERAL") // GENERAL, BUG, SCIENCE, USABILITY, FEATURE
  message     String
  /** Where in the lab they were when they sent it. */
  screen      String?
  /** Build identifier, so a report can be tied to the code that produced it. */
  appVersion  String?
  status      String   @default("NEW") // NEW, TRIAGED, ACTIONED, DECLINED
  adminNotes  String?
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab  Lab? @relation(fields: [labId], references: [id], onDelete: SetNull)

  @@index([labSlug, createdAt])
  @@index([status, createdAt])
  @@index([userId])
}

/**
 * A completed NanoSchool Expert Review Form.
 *
 * The form is fixed by the review process, not by this schema, so the parts of
 * it that are lists — the ten rating rows, the issues table, the domain
 * checklists — are stored as JSON rather than as columns. That is a deliberate
 * trade: querying "how many reviewers rated Reproducibility as Major Concern"
 * needs application code instead of SQL, and in exchange a change to the form
 * does not need a migration and cannot silently drop a reviewer's answer into
 * a column that no longer exists. The shapes are typed in
 * src/lib/reviewForm.ts and shared with the lab that renders them.
 *
 * A reviewer may review the same lab more than once — a re-review after
 * corrections is one of the form's own outcomes — so rows are not unique per
 * user and lab. `versionBuild` is what distinguishes them, which is why the
 * lab fills it in from its own build identifier rather than asking.
 */
model LabReview {
  id     String @id @default(cuid())
  userId String
  labId  String?
  labSlug String?

  /// Free text from the form's header, as the reviewer entered it.
  reviewerName    String
  areaOfExpertise String
  /// The build under review, taken from the lab rather than typed.
  versionBuild    String?

  /// Section A — ten review areas, each EXCELLENT | GOOD | NEEDS_IMPROVEMENT | MAJOR_CONCERN | NA.
  ratings Json

  /// Section B — issues, each { module, severity, observation, recommendation }.
  issues Json

  /// Section C — domain checklists, keyed by domain, each an array of checked item ids.
  domainChecks Json

  /// Section D.
  finalRecommendation String?
  mostImportantCorrection String?
  optionalSuggestions     String?
  reviewerComments        String?

  /// Set when an administrator clears a review out of the admin queue.
  ///
  /// Archiving rather than deleting: these are signed expert assessments tied
  /// to the exact build they were written against, and a reviewer's signed
  /// opinion is not something a misclick should be able to destroy. The row
  /// stays, the queue stops showing it.
  archivedAt DateTime?
  /// The admin account that archived it.
  archivedBy String?

  /// DRAFT while being written; SUBMITTED once the reviewer signs it off.
  status      String    @default("DRAFT")
  submittedAt DateTime?
  /// The date the reviewer put on the form, which may not be the submit date.
  reviewDate  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab  Lab? @relation(fields: [labId], references: [id], onDelete: SetNull)

  @@index([labSlug, status])
  @@index([userId, status])
}

/**
 * A signed Expert Reviewer Agreement & Confidentiality Undertaking.
 *
 * Kept separate from LabReview because it is a different kind of record. A
 * review is an opinion that can be superseded; this is a commitment made at a
 * point in time, and it has to stay exactly as it was signed even after the
 * agreement wording changes or the reviewer's access ends.
 *
 * `agreementVersion` and `agreementFingerprint` are both stored, and the second
 * is the one that catches mistakes. The version is bumped by hand and can be
 * forgotten; the fingerprint is computed from the displayed text, so an edit to
 * the wording that nobody thought to version is still visible afterwards as a
 * mismatch against what this reviewer actually saw.
 *
 * One row per reviewer, lab and agreement version. A reviewer who has signed
 * the current version is not asked again; a new version asks everyone afresh,
 * which is the only honest way to handle a changed undertaking.
 */
model ReviewerAgreement {
  id      String  @id @default(cuid())
  userId  String
  labId   String?
  labSlug String?

  /// The header fields the document asks for.
  labTitle           String
  domain             String
  reviewBuild        String?
  reviewerName       String
  designation        String
  institution        String
  email              String
  dateAccessProvided String?
  expectedCompletion String?

  /// The ticked review roles, e.g. ["SCIENTIFIC", "EDUCATIONAL_UX"].
  reviewRoles Json

  /// The typed name standing as the signature, and the date put on the form.
  signature  String
  signedDate String?

  /// Which agreement was signed, and a fingerprint of the exact text shown.
  agreementVersion     String
  agreementFingerprint String

  acknowledgedAt DateTime @default(now())
  /// Set if the agreement is later withdrawn or access is closed.
  revokedAt      DateTime?
  revokedBy      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab  Lab? @relation(fields: [labId], references: [id], onDelete: SetNull)

  @@unique([userId, labId, agreementVersion])
  @@index([labSlug, acknowledgedAt])
}

model AuthorizationLog {
  id          String   @id @default(cuid())
  userId      String?
  userEmail   String?
  labId       String
  labSlug     String?
  tokenPrefix String?
  status      String   // SUCCESS | FAILED_EXPIRED | FAILED_UNAUTHORIZED | FAILED_INVALID_TOKEN | FAILED_INACTIVE_USER
  ipAddress   String?
  userAgent   String?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([labId, status])
  @@index([userId, status])
  @@index([createdAt])
  @@map("authorization_logs")
}

/// Work a learner saved inside a lab, so it follows their account rather than
/// their browser.
///
/// Labs run on their own origins and previously kept project history in
/// localStorage, which meant a learner who signed in from a second machine
/// found an empty lab. This table is the account-scoped store behind that.
///
/// `payload` is opaque to the hub on purpose. Each lab owns the shape of its
/// own results, and the hub has no business parsing metagenomics output to save
/// it — it stores what the lab sends and hands it back unchanged. `title` and
/// `summary` are duplicated out of it only so the hub can list projects without
/// deserialising every payload.
///
/// No raw scientific input is stored here. MicrobeAI, for one, never sends
/// sequence data: its own retention rule is that reads do not outlive the tab.
model LabProject {
  id        String   @id @default(cuid())
  userId    String
  labId     String
  /// The lab's own identifier for the project, unique within a lab per user.
  projectRef String
  title     String
  /// Short human-readable status line for the list view.
  summary   String?
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, labId, projectRef])
  @@index([userId, labId, updatedAt])
  @@map("lab_projects")
}

/// A learner's progress through a lab's authored tutorial.
///
/// This used to live only in the browser's `localStorage`, which meant it did
/// not follow the learner to a second device and the dashboard could not show
/// it at all — every "progress" figure on a dashboard built over that storage
/// would have been a guess. This is the account-scoped store behind it.
///
/// Keyed by `labSlug` rather than `Lab.id` because the steps are defined by the
/// authored guide in `src/content/labs/<slug>.ts`, which is keyed by slug. A
/// lab row can be re-imported and change id; the guide it points at does not.
model LabProgress {
  id             String    @id @default(cuid())
  userId         String
  labSlug        String
  /// Indices of completed steps, in the guide's authored order.
  completedSteps Int[]
  /// How many steps the guide had when this row was last written. Stored so the
  /// dashboard can show a percentage without loading every guide module, and so
  /// a guide that later gains a step cannot report more than 100% complete.
  totalSteps     Int       @default(0)
  startedAt      DateTime  @default(now())
  lastActiveAt   DateTime  @updatedAt
  /// Set when every step is ticked, and cleared again if one is un-ticked, so
  /// "Completed" always reflects the current state rather than a high-water mark.
  completedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, labSlug])
  @@index([userId, lastActiveAt])
  @@map("lab_progress")
}
