# ---- Required ----
# NextAuth session encryption secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Public URL of the deployment (must match the domain Coolify serves).
NEXTAUTH_URL="https://labs.example.com"
# PostgreSQL connection string (use your Coolify Postgres service's internal URL).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# ---- Optional ----
# "Continue with Google" on the login and register screens. Both variables must
# be set for the button to work; without them it stays visible but disabled.
#
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorised redirect URI:
#   <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Password recovery email. Without a key the reset link is written to the
# server log instead of being sent, which is fine locally but means nobody can
# actually recover an account in production — set this before launch.
# Get a key at resend.com, then verify your sending domain.
RESEND_API_KEY=""
MAIL_FROM="Panoptical Labs <no-reply@your-domain.com>"

# Razorpay live payments. Leave blank to use the built-in mock checkout.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Source API for `npm run import:labs` re-sync. If unreachable, the committed
# prisma/labs-snapshot.json is used automatically.
LAB_SOURCE_URL=""

# ---------------------------------------------------------------------------
# Language model for the labs
# ---------------------------------------------------------------------------
#
# Set the key HERE, on the platform, and nowhere else.
#
# Labs are static browser bundles. Anything their build inlines — every
# VITE_-prefixed variable — is readable by anyone who opens the served
# JavaScript, and billable to whoever owns the key. There is no build-time
# setting that avoids that; the problem is the browser, not the setting. So the
# labs hold no key at all: they POST their prompt to /api/labs/llm and this
# server adds the credential.
#
# Note the names. LLM_API_KEY, never NEXT_PUBLIC_LLM_API_KEY — the
# NEXT_PUBLIC_ prefix is Next's equivalent of VITE_ and would publish the key
# into the client bundle, recreating exactly the problem this arrangement
# solves.
#
# Every call is authenticated with the caller's lab session token, so the relay
# is not an open endpoint. Leave the key unset and labs fall back to their
# deterministic templates, which is a supported state rather than a broken one.

# The provider key. Vendor is detected from its prefix:
#   sk-or-…    OpenRouter
#   sk-ant-…   Anthropic
#   AIza… AQ.… Google Gemini
#   sk-… gsk_… OpenAI-compatible (OpenAI, Groq, Together, DeepSeek, Fireworks…)
LLM_API_KEY=

# Model id. Defaults per provider when unset. Set it if your key has no quota
# for the default — a key can be valid and still return 429 for one model.
LLM_MODEL=

# Only needed to override the vendor default: a self-hosted OpenAI-compatible
# server, a regional endpoint, or a gateway. A Groq key (gsk_) needs this,
# because it speaks the OpenAI wire format from a different host.
LLM_BASE_URL=

# Only needed when the key prefix is not recognisable. One of:
#   openrouter | openai-compatible | google | anthropic
LLM_PROVIDER=
