# ---- Required ----
# NextAuth session encryption secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Public URL of the deployment (must match the domain Coolify serves).
NEXTAUTH_URL="https://labs.example.com"
# PostgreSQL connection string (use your Coolify Postgres service's internal URL).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# ---- Optional ----
# Single sign-on. Each provider appears on the login page only when both of its
# variables are set, so leaving these blank simply hides the option.
#
# Google:    console.cloud.google.com -> APIs & Services -> Credentials ->
#            OAuth client ID (Web application). Authorised redirect URI:
#            <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Microsoft: portal.azure.com -> Entra ID -> App registrations -> New. Redirect
#            URI (Web): <NEXTAUTH_URL>/api/auth/callback/azure-ad
#            Leave AZURE_AD_TENANT_ID blank for "common" (any work/school
#            account), or set a directory ID to allow one organisation only.
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Password recovery email. Without a key the reset link is written to the
# server log instead of being sent, which is fine locally but means nobody can
# actually recover an account in production — set this before launch.
# Get a key at resend.com, then verify your sending domain.
RESEND_API_KEY=""
MAIL_FROM="Panoptical Labs <no-reply@your-domain.com>"

# Biometric sign-in (WebAuthn passkeys) needs no configuration: the relying
# party ID is derived from NEXTAUTH_URL. It does require HTTPS in production —
# browsers only allow passkeys on a secure origin (localhost is exempt).

# Razorpay live payments. Leave blank to use the built-in mock checkout.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Source API for `npm run import:labs` re-sync. If unreachable, the committed
# prisma/labs-snapshot.json is used automatically.
LAB_SOURCE_URL=""
